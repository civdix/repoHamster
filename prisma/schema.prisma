datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CANDIDATE
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CandidateAssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

enum EvaluationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  MANUAL_OVERRIDE
}

enum TestSuiteType {
  PUBLIC
  HIDDEN
}

enum TestStatus {
  PASSED
  FAILED
  SKIPPED
}

enum WebhookStatus {
  PROCESSED
  IGNORED
  FAILED
}

model User {
  id             String                @id @default(uuid())
  email          String                @unique
  username       String?               @unique
  name           String?
  role           Role                  @default(CANDIDATE)
  githubId       String?               @unique
  githubUsername String?
  avatarUrl      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  assignments    CandidateAssignment[]
  pullRequests   PullRequest[]
  aiUsages       AIUsage[]
  overrides      Evaluation[]          @relation("ManualOverrides")

  @@index([username])
  @@index([githubUsername])
  @@index([email])
}

model CatalogRepository {
  id                  String       @id @default(uuid())
  name                String       @unique
  originalUrl         String       @unique
  owner               String
  repoName            String
  defaultBranch       String       @default("main")
  language            String
  framework           String
  category            String
  difficulty          Difficulty   @default(INTERMEDIATE)
  description         String
  license             String       @default("NO_LICENSE")
  isCommercialAllowed Boolean      @default(false)
  sourceType          String       @default("COMPLETE_APP")
  importStatus        String       @default("DISCOVERED")
  evaluationReadiness String       @default("NEEDS_HARNESS")
  testAvailability    String       @default("PUBLIC_ONLY")
  localPath           String?
  inspectionReport    Json
  validationResult    Json?
  lastInspectedAt     DateTime     @default(now())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  assignments         Assignment[]

  @@index([importStatus])
  @@index([language])
  @@index([category])
}

model Assignment {
  id                      String                @id @default(uuid())
  slug                    String                @unique
  title                   String
  description             String
  repoUrl                 String
  baseBranch              String                @default("main")
  difficulty              Difficulty            @default(INTERMEDIATE)
  language                String
  framework               String
  estimatedTimeMinutes    Int                   @default(45)
  instructions            String
  publicTestInfo          String
  hiddenTestSpec          Json
  passingThresholdPercent Float                 @default(100.0)
  isActive                Boolean               @default(true)
  aiRequestLimit          Int                   @default(15)
  aiTokenLimit            Int                   @default(10000)
  catalogRepositoryId     String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  catalogRepository       CatalogRepository?    @relation(fields: [catalogRepositoryId], references: [id], onDelete: SetNull)
  candidateAssignments   CandidateAssignment[]
  pullRequests            PullRequest[]
  aiUsages                AIUsage[]

  @@index([slug])
  @@index([isActive])
  @@index([catalogRepositoryId])
}

model CandidateAssignment {
  id           String                    @id @default(uuid())
  candidateId  String
  assignmentId String
  status       CandidateAssignmentStatus @default(NOT_STARTED)
  startedAt    DateTime                  @default(now())
  completedAt  DateTime?

  candidate    User                      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignment   Assignment                @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissions  Submission[]

  @@unique([candidateId, assignmentId])
  @@index([candidateId])
  @@index([assignmentId])
  @@index([status])
}

model PullRequest {
  id           String           @id @default(uuid())
  candidateId  String
  assignmentId String
  prNumber     Int
  prUrl        String
  repoFullName String
  branchName   String
  state        PullRequestState @default(OPEN)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  candidate    User             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissions  Submission[]

  @@unique([repoFullName, prNumber])
  @@index([candidateId])
  @@index([assignmentId])
}

model Submission {
  id                    String              @id @default(uuid())
  candidateAssignmentId String
  pullRequestId         String?
  commitSha             String              @unique
  commitMessage         String?
  submittedAt           DateTime            @default(now())

  candidateAssignment   CandidateAssignment @relation(fields: [candidateAssignmentId], references: [id], onDelete: Cascade)
  pullRequest           PullRequest?        @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  evaluation            Evaluation?

  @@index([candidateAssignmentId])
  @@index([commitSha])
}

model Evaluation {
  id                   String           @id @default(uuid())
  submissionId         String           @unique
  status               EvaluationStatus @default(QUEUED)
  totalTests           Int              @default(0)
  passedTests          Int              @default(0)
  failedTests          Int              @default(0)
  scorePercent         Float            @default(0.0)
  isPassed             Boolean          @default(false)
  logs                 String?
  executionTimeMs      Int              @default(0)
  evaluatedAt          DateTime?
  manualOverrideById   String?
  manualOverrideReason String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  submission           Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  manualOverrideBy     User?            @relation("ManualOverrides", fields: [manualOverrideById], references: [id], onDelete: SetNull)
  testResults          TestResult[]

  @@index([submissionId])
  @@index([status])
  @@index([isPassed])
}

model TestResult {
  id              String        @id @default(uuid())
  evaluationId    String
  testName        String
  testSuite       TestSuiteType @default(PUBLIC)
  status          TestStatus    @default(PASSED)
  executionTimeMs Int           @default(0)
  errorMessage    String?
  isHidden        Boolean       @default(false)
  createdAt       DateTime      @default(now())

  evaluation      Evaluation    @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@index([testSuite])
}

model AIUsage {
  id               String      @id @default(uuid())
  candidateId      String
  assignmentId     String?
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  totalTokens      Int         @default(0)
  query            String
  responseSnippet  String?
  createdAt        DateTime    @default(now())

  candidate        User        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignment       Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([candidateId, createdAt])
}

model AdminSettings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model GitHubInstallation {
  id             String   @id @default(uuid())
  installationId String   @unique
  accountLogin   String
  accountType    String
  createdAt      DateTime @default(now())

  @@index([installationId])
}

model WebhookEvent {
  id         String        @id @default(uuid())
  deliveryId String        @unique
  eventType  String
  payload    Json
  status     WebhookStatus @default(PROCESSED)
  error      String?
  createdAt  DateTime      @default(now())

  @@index([deliveryId])
  @@index([eventType])
}
