{
  "name": "repohamster",
  "version": "1.0.0",
  "description": "RepoHamster - Break Bugs. Ship Fixes. AI-Assisted Developer Debugging Assessment Platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate.mjs && next build",
    "postinstall": "node scripts/prisma-generate.mjs",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "test:runner": "node scripts/test-evaluation-runner.mjs",
    "test:catalogue": "node scripts/test-catalogue-and-runner.mjs",
    "test:ai": "node scripts/test-ai-factory.mjs",
    "test": "npm run test:runner && npm run test:catalogue && npm run test:ai"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^14.2.20",
    "next-auth": "^4.24.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
