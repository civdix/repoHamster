# ==============================================================================
# DebugLab Environment Configuration Template
# ==============================================================================

# PostgreSQL Database Connection URL (Supabase, Neon, AWS RDS, or Docker)
# Example Docker URL: postgresql://debuglab:debuglab_password@localhost:5432/debuglab_db?schema=public
# Example SQLite fallback URL for instant zero-dependency local testing: file:./dev.db
DATABASE_URL="postgresql://debuglab:debuglab_password@localhost:5432/debuglab_db?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="debuglab_super_secret_jwt_and_session_signing_key_at_least_32_chars"

# Admin Bypass / Default Credentials for Local Testing
ADMIN_EMAIL="admin@debuglab.internal"
ADMIN_PASSWORD="DebugLabAdmin2026!"

# GitHub OAuth App Credentials (for Candidate Sign-In)
# Register at: https://github.com/settings/applications/new
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID="your_github_oauth_client_id"
GITHUB_SECRET="your_github_oauth_client_secret"

# GitHub App / Webhook Secrets
# Configure your repository webhook payload URL: https://your-domain.com/api/webhooks/github
# Content type: application/json
GITHUB_WEBHOOK_SECRET="debuglab_webhook_hmac_secret_key"
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""

# AI Assistant Configuration (Factory Architecture)
# Options: 'groq' (ultra-fast LPU), 'gemini', 'openai', or 'mock' (automatic fallback if no keys configured)
AI_PROVIDER="groq"

# Groq API Configuration (Fastest inference with Llama 3.3 70B & Llama 3.1 8B)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Google Gemini Configuration
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI Configuration
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Default AI Rate Limits
DEFAULT_AI_DAILY_REQUEST_LIMIT=15
DEFAULT_AI_TOKEN_LIMIT=10000
DEFAULT_AI_MAX_OUTPUT_TOKENS=600

# Automated Test Evaluation Runner Driver
# Options: 'isolated-process' (default, safe node/python sandbox), 'docker', or 'mock'
RUNNER_DRIVER="isolated-process"
